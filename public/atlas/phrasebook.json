        { "en": "Can I?",            "fr": "Je peux ?",          "es": "¿Puedo?",         "it": "Posso?",          "pt": "Posso?",           "de": "Darf ich?",      "ja": "いいですか (ii desu ka)" },
        { "en": "Do you have…?",     "fr": "Avez-vous… ?",       "es": "¿Tiene…?",        "it": "Avete…?",         "pt": "Tem…?",            "de": "Haben Sie…?",    "ja": "～がありますか (~ ga arimasu ka)" },
